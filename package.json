{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 9002",
    "build": "NODE_ENV=production next build --webpack",
    "start": "next start",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "deploy:apphosting": "bash scripts/apphosting/deploy.sh",
    "release:apphosting": "bash scripts/apphosting/release.sh",
    "release:apphosting:minor": "BUMP=minor bash scripts/apphosting/release.sh",
    "release:apphosting:major": "BUMP=major bash scripts/apphosting/release.sh",
    "migrate-deleted-at": "tsx scripts/migrations/migrate-deleted-at.ts",
    "migrate-signer-emails": "tsx scripts/migrations/migrate-signer-emails.ts",
    "migrate-user-memberships": "tsx scripts/migrations/migrate-user-memberships.ts --execute",
    "remove-activity-description": "tsx scripts/migrations/remove-activity-description.ts",
    "memberships:list": "tsx scripts/admin/manage-memberships.ts list",
    "memberships:add": "tsx scripts/admin/manage-memberships.ts add",
    "memberships:remove": "tsx scripts/admin/manage-memberships.ts remove",
    "memberships:set-active": "tsx scripts/admin/manage-memberships.ts set-active",
    "pull-firestore-rules": "node scripts/firestore/pull-firestore-rules.js",
    "update-firestore": "firebase deploy --only firestore:rules,firestore:indexes",
    "export:env:json": "bash scripts/apphosting/export-env-json.sh",
    "env:pull": "sh -c 'infisical export --format=dotenv --env=${INFISICAL_ENV:-dev} --path=${INFISICAL_SECRET_PATH:-/} ${INFISICAL_PROJECT_ID:+--projectId=$INFISICAL_PROJECT_ID} > .env'",
    "env:pull:staging": "INFISICAL_ENV=staging npm run env:pull",
    "env:pull:prod": "INFISICAL_ENV=prod npm run env:pull",
    "secrets:sync": "bash scripts/apphosting/sync-infisical-to-gsm.sh",
    "secrets:sync:dev": "INFISICAL_ENV=dev bash scripts/apphosting/sync-infisical-to-gsm.sh",
    "secrets:sync:staging": "INFISICAL_ENV=staging bash scripts/apphosting/sync-infisical-to-gsm.sh",
    "release:full": "bash scripts/apphosting/release-full.sh",
    "release:full:minor": "BUMP=minor bash scripts/apphosting/release-full.sh",
    "release:full:major": "BUMP=major bash scripts/apphosting/release-full.sh"
  },
  "engines": {
    "node": ">=20.0.0 <25"
  },
  "dependencies": {
    "@genkit-ai/googleai": "1.28.0",
    "@google-cloud/firestore": "^7.11.6",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "colorthief": "^2.6.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.8.0",
    "firebase-admin": "^13.6.0",
    "genkit": "1.28.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "patch-package": "^8.0.1",
    "react": "^19.2.4",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "react-signature-canvas": "^1.0.7",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/react-signature-canvas": "^1.0.7",
    "autoprefixer": "^10.4.23",
    "postcss": "^8",
    "puppeteer": "^24.37.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
