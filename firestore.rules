rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // As regras mais específicas devem vir primeiro.

    // Coleção de Usuários (users)
    // Permite a um usuário ler e atualizar seus próprios dados.
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // Regras para subcoleções de Empresa
    match /companies/{companyId} {
      // Admins da empresa podem ler a empresa
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
      
      // Admins da empresa podem gerenciar obras, funcionários, cargos e terceirizadas
      match /works/{workId} {
        allow read, write, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
      }
      
      match /employees/{employeeId} {
        allow read, write, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
      }

      match /jobRoles/{jobRoleId} {
        allow read, write, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
      }

      match /subcontractors/{subcontractorId} {
        allow read, write, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
      }
    }

    // Regra geral para as outras coleções.
    // Permite leitura e escrita em qualquer outro documento
    // apenas se o usuário estiver autenticado.
    // Vamos refinar isso conforme o app crescer.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
